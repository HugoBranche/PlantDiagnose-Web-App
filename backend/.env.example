# Copy this file to .env and fill in real values before running the server.

PORT=4000

# Any long random string — used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_string

# Free "Read" token from huggingface.co -> Settings -> Access Tokens.
# Used to call the pretrained plant-disease model via HF's Inference API.
HF_TOKEN=hf_paste_your_token_here

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

SUPABASE_URL=https://seciwxfoyauyyyrzdupo.supabase.co/rest/v1/
SUPABASE_SERVICE_KEY=sb_secret_YIcX9ANNK8sFezdGmLG9NQ_GIjVm-J0
